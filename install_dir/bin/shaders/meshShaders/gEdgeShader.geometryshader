#version 330 core

layout (triangles) in;
layout (line_strip, max_vertices = 3) out;

// viewport matrix
uniform mat4 V;
uniform mat4 P;

// inputs
in DATA
{
	vec4 vertexPosCamera;
	vec4 vertexNormCamera;
	vec4 lightPosCamera;
	mat4 view;
} data_in[];

// outputs
out vec4 vertexPosCamera;
out vec4 vertexNormCamera;
out vec4 lightPosCamera;

noperspective out vec3 EdgeDistance;

float sf = 1;

mat4 S = mat4(
    sf, 0, 0, 0,
    0, sf, 0, 0,
    0, 0, sf, 0,
    0, 0, 0, 1
);

void add_edge(int idx1, int idx2){
    gl_Position = P * S * gl_in[idx1].gl_Position;
    EmitVertex();

    gl_Position = P * S * gl_in[idx2].gl_Position;
    EmitVertex();

    EndPrimitive();
};


void main(){
	
    // first edge line from 0 - 1
    // add_edge(0, 1);
    // add_edge(1, 2);
    // add_edge(2, 0);

    vec4 p;
    p = gl_in[0].gl_Position;
    vec2 p0 = vec2(V * (p / p.w));

    p = gl_in[1].gl_Position;
    vec2 p1 = vec2(V * (p / p.w));

    p = gl_in[2].gl_Position;
    vec2 p2 = vec2(V * (p / p.w));

    float a = length(p1 - p2);
    float b = length(p2 - p0);
    float c = length(p1 - p0);

    float alpha = acos((b * b + c * c - a * a) / (2.0 * b * c));
    float beta = acos((a * a + c * c - b * b) / (2.0 * a * c));

    float ha = abs(c * sin(beta));
    float hb = abs(c * sin(alpha));
    float hc = abs(b * sin(alpha));

    gl_Position = P * S * gl_in[0].gl_Position;
    gl_ClipDistance = gl_in[0].gl_ClipDistance;
    EdgeDistance = vec3(ha, 0, 0);
    EmitVertex();

    gl_Position = P * S * gl_in[1].gl_Position;
    gl_ClipDistance = gl_in[1].gl_ClipDistance;
    EdgeDistance = vec3(0, hb, 0);
    EmitVertex();

    gl_Position = P * S * gl_in[2].gl_Position;
    gl_ClipDistance = gl_in[2].gl_ClipDistance;
    EdgeDistance = vec3(0, 0, hc);
    EmitVertex();

    EndPrimitive();
};
