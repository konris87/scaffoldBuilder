#version 330 core
layout (location = 0) in vec3 seedPos;
layout (location = 1) in mat4 aInstanceMatrix;

uniform mat4 projection;
uniform mat4 view;
uniform float seedSize;

void main()
{
	// glPosition is the output of the vertex shader
	gl_Position = projection * view * aInstanceMatrix * vec4(seedPos * seedSize, 1.0);
}