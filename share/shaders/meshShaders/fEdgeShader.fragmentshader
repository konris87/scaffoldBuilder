#version 330 core

noperspective in vec3 EdgeDistance;
out vec4 FragColor;

float gWireframeWidth = 1.0;

void main()
{

    float d = min(EdgeDistance.x, min(EdgeDistance.y, EdgeDistance.z));

    float mixVal = 0.0;

    if (d < gWireframeWidth - 1){
        mixVal = 1.0;
    }
    else if (d > gWireframeWidth + 1){
        mixVal = 0.0;
    }
    else {
        float x = d - (gWireframeWidth - 1);
        mixVal = exp2(-2.0 * x * x);
    }

    FragColor = vec4(0.0, 0.0, 0.0, 1.0);
}  