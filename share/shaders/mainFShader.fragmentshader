#version 330 core

// uniforms for lighting options
uniform float Ka; 
uniform float Ks;
uniform vec3 lightColor;
uniform vec4 objectColor;
uniform vec4 cutPlaneCoeffs;
uniform bool cutPlane;

// inputs from vertex shader
in vec4 vertexPosWorld;
in vec4 vertexPosCamera;
in vec4 vertexNormCamera;
in vec4 lightPosCamera;

// output: fragment color
out vec4 FragColor;

void main()
{
	
    // Ambient
    vec3 ambient = Ka * lightColor;

    // Diffuse
    vec3 N = normalize(vertexNormCamera.xyz);
    vec3 L = normalize((lightPosCamera - vertexPosCamera).xyz);
    float cosTheta = max(dot(N, L), 0.0);
    vec3 diffuse = lightColor * cosTheta;

    // Specular (optional, using camera position (0,0,0,1) in view space)
    vec3 V = normalize(-vertexPosCamera.xyz);
    vec3 R = reflect(-L, N);
    float cosAlpha = max(dot(V, R), 0.0);
    vec3 specular = Ks * lightColor * pow(cosAlpha, 32.0);

    vec3 lighting = ambient + diffuse + specular;
    FragColor = vec4(lighting, 1.0) * objectColor;
	
	if (cutPlane){
		float d = dot(cutPlaneCoeffs, vertexPosWorld);
	
		if (d < 0){
			
			discard;
		
		}
	}
	
}